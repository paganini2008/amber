# Amber backend configuration. Copy to backend/.env (git-ignored) and fill in what you need.
# Process environment variables override this file. A packaged app never reads it: only the engine
# running from this source tree (or AMBER_ENV_FILE=/path/to/.env) does.

# ---- Engine ---------------------------------------------------------------------------------
# Threads that parse statements in parallel (default: number of CPUs, at least 2)
AMBER_PARSER_THREADS=
# Threads that serve JSON-RPC requests (default: number of CPUs, at least 2)
AMBER_RPC_THREADS=
# Online mode: login, network and metadata-call timeout in seconds (default 15)
AMBER_JDBC_TIMEOUT_SECONDS=15

# ---- Integration tests (amber-test) -------------------------------------------------------------
# LlmIT: a real round trip to an OpenAI-compatible API (context -> masked prompt -> answer -> ai.check).
# Skipped without a key. Only Amber's masked analysis of synthetic test SQL is sent.
OPENAI_API_KEY=
# Optional: another OpenAI-compatible endpoint and model (defaults: https://api.openai.com/v1, gpt-4.1-mini)
AMBER_IT_OPENAI_BASE_URL=
AMBER_IT_OPENAI_MODEL=

# Per-file parse timeout of CorpusParseIT in seconds (default 60)
AMBER_CORPUS_TIMEOUT_SECONDS=60

# Database connections never go into .env. In the app they are entered on the spot in
# Settings > Connections (passwords are stored encrypted by the OS keychain). Test connections of the
# optional OnlineMetadataIT live in the test configuration
# amber-test/src/test/resources/online-it.properties (git-ignored; see the .example next to it).
