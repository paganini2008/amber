/*
 * H2 Database (2.x) SQL parser grammar.
 *
 * Written from scratch for Amber (a SQL script structure visualizer) using the
 * public H2 documentation as the reference: https://h2database.com/html/grammar.html
 * (commands, other grammar, data types, functions, keywords pages).
 * No H2 source code was used.
 *
 * The grammar is deliberately permissive: it parses, it does not validate.
 * Words that H2 reserves only in some modes or contexts (VALUE, KEY, YEAR, USER, ...)
 * are accepted as identifiers wherever this is unambiguous, because real scripts use
 * them as column names (often together with SET NON_KEYWORDS).
 *
 * The keyword token list in H2Lexer.g4 and the non_reserved_keyword rule at the end of
 * this file are generated by tools/generate_keywords.py from the tokens used here.
 */
parser grammar H2Parser;

options {
    tokenVocab = H2Lexer;
}

// ============================================================================
// Script
// ============================================================================

script
    : SEMI* (statement (SEMI+ statement)* SEMI*)? EOF
    ;

statement
    : with_statement
    | query_statement
    | insert_statement
    | update_statement
    | delete_statement
    | merge_into_statement
    | merge_using_statement
    | replace_statement
    | call_statement
    | execute_immediate_statement
    | explain_statement
    | backup_statement
    | runscript_statement
    | script_statement
    | show_statement
    | help_statement
    | create_statement
    | alter_statement
    | drop_statement
    | truncate_statement
    | refresh_materialized_view_statement
    | comment_statement
    | analyze_statement
    | grant_statement
    | revoke_statement
    | transaction_statement
    | checkpoint_statement
    | shutdown_statement
    | set_statement
    ;

// ============================================================================
// Queries
// ============================================================================

query_statement
    : query_body
    ;

// A statement that starts with WITH: the CTE list is parsed once, then the body decides.
with_statement
    : with_clause
      (query_body | insert_statement | update_statement | delete_statement
      | merge_into_statement | merge_using_statement | create_table_statement)
    ;

query
    : with_clause? query_body
    ;

query_body
    : query_expression_body order_by_clause? limit_clauses? for_update_clause?
    ;

with_clause
    : WITH RECURSIVE? common_table_expression (COMMA common_table_expression)*
    ;

common_table_expression
    : identifier column_name_list? AS LPAREN query RPAREN
    ;

query_expression_body
    : query_term (set_operator query_term)*
    ;

set_operator
    : (UNION | EXCEPT | MINUS) (ALL | DISTINCT)?
    ;

query_term
    : query_primary (INTERSECT (ALL | DISTINCT)? query_primary)*
    ;

query_primary
    : query_specification
    | table_value_constructor
    | explicit_table
    | LPAREN query RPAREN
    ;

explicit_table
    : TABLE qualified_name
    ;

table_value_constructor
    : VALUES row_value (COMMA row_value)*
    ;

row_value
    : expression
    ;

query_specification
    : SELECT top_clause? set_quantifier? select_list
      (FROM table_reference_list)?
      (WHERE where_condition=expression)?
      (GROUP BY group_by_list)?
      (HAVING having_condition=expression)?
      window_clause?
      (QUALIFY qualify_condition=expression)?
    ;

top_clause
    : TOP value_expression PERCENT? (WITH TIES)?
    ;

set_quantifier
    : DISTINCT (ON LPAREN expression_list RPAREN)?
    | ALL
    ;

select_list
    : select_item (COMMA select_item)*
    ;

select_item
    : wildcard_expression
    | expression (AS identifier | alias_name)?
    ;

wildcard_expression
    : (qualified_name DOT)? STAR (EXCEPT LPAREN qualified_name (COMMA qualified_name)* RPAREN)?
    ;

// ---------------------------------------------------------------------------
// FROM clause, joins
// ---------------------------------------------------------------------------

table_reference_list
    : table_reference (COMMA table_reference)*
    ;

table_reference
    : table_primary join_clause*
    ;

join_clause
    : join_type? JOIN table_primary join_specification?
    | CROSS JOIN table_primary
    | NATURAL join_type? JOIN table_primary
    ;

join_type
    : INNER
    | (LEFT | RIGHT | FULL) OUTER?
    ;

join_specification
    : ON expression
    | USING column_name_list
    ;

table_primary
    : qualified_name table_alias? index_hint?                              # table_name_primary
    | LATERAL? LPAREN query RPAREN table_alias?                            # derived_table_primary
    | LPAREN table_reference RPAREN                                       # parenthesized_join_primary
    | data_change_delta_table table_alias?                                # delta_table_primary
    | (TABLE | TABLE_DISTINCT)
      LPAREN table_function_column (COMMA table_function_column)* RPAREN
      table_alias?                                                        # table_function_primary
    | function_call (WITH ORDINALITY)? table_alias?                       # function_table_primary
    ;

table_function_column
    : identifier data_type EQ expression
    ;

data_change_delta_table
    : (OLD | NEW | FINAL) TABLE LPAREN
      (insert_statement | update_statement | delete_statement | merge_into_statement | merge_using_statement)
      RPAREN
    ;

table_alias
    : (AS identifier | alias_name) column_name_list?
    ;

index_hint
    : USE INDEX LPAREN (identifier (COMMA identifier)*)? RPAREN
    ;

// ---------------------------------------------------------------------------
// GROUP BY, WINDOW, ORDER BY, LIMIT
// ---------------------------------------------------------------------------

group_by_list
    : group_by_element (COMMA group_by_element)*
    ;

group_by_element
    : GROUPING SETS LPAREN group_by_element (COMMA group_by_element)* RPAREN
    | ROLLUP LPAREN expression_list RPAREN
    | CUBE LPAREN expression_list RPAREN
    | LPAREN RPAREN
    | expression
    ;

window_clause
    : WINDOW window_definition (COMMA window_definition)*
    ;

window_definition
    : identifier AS LPAREN window_specification RPAREN
    ;

window_specification
    : window_name_ref=identifier? (PARTITION BY expression_list)? order_by_clause? window_frame?
    ;

window_frame
    : (ROWS | RANGE | GROUPS)
      (BETWEEN window_frame_bound AND window_frame_bound | window_frame_bound)
      window_frame_exclusion?
    ;

window_frame_bound
    : UNBOUNDED (PRECEDING | FOLLOWING)
    | CURRENT ROW
    | value_expression (PRECEDING | FOLLOWING)
    ;

window_frame_exclusion
    : EXCLUDE (CURRENT ROW | GROUP | TIES | NO OTHERS)
    ;

order_by_clause
    : ORDER BY sort_specification (COMMA sort_specification)*
    ;

sort_specification
    : expression (ASC | DESC)? (NULLS (FIRST | LAST))?
    ;

limit_clauses
    : offset_clause fetch_clause?
    | fetch_clause offset_clause?
    | limit_clause
    ;

offset_clause
    : OFFSET value_expression (ROW | ROWS)?
    ;

fetch_clause
    : FETCH (FIRST | NEXT) (value_expression PERCENT?)? (ROW | ROWS) (ONLY | WITH TIES)
    ;

limit_clause
    : LIMIT value_expression ((OFFSET | COMMA) value_expression)?
    ;

for_update_clause
    : FOR UPDATE (OF qualified_name (COMMA qualified_name)*)? (NOWAIT | WAIT value_expression | SKIP_ LOCKED)?
    ;

// ============================================================================
// Data manipulation
// ============================================================================

insert_statement
    : INSERT IGNORE? INTO qualified_name column_name_list?
      (OVERRIDING (USER | SYSTEM) VALUE)?
      insert_source
      on_duplicate_key_update?
    ;

insert_source
    : DIRECT? query
    | DEFAULT VALUES
    | SET assignment (COMMA assignment)*
    ;

on_duplicate_key_update
    : ON DUPLICATE KEY UPDATE assignment (COMMA assignment)*
    ;

replace_statement
    : REPLACE INTO qualified_name column_name_list? query
    ;

update_statement
    : UPDATE qualified_name table_alias_no_columns?
      SET assignment (COMMA assignment)*
      (FROM table_reference_list)?
      (WHERE expression)?
      order_by_clause?
      (limit_clause | fetch_clause)?
    ;

table_alias_no_columns
    : AS identifier
    | alias_name
    ;

assignment
    : qualified_name EQ expression
    | column_name_list EQ expression
    ;

delete_statement
    : DELETE (TOP value_expression)? FROM? qualified_name table_alias_no_columns?
      (WHERE expression)?
      (limit_clause | fetch_clause)?
    ;

merge_into_statement
    : MERGE INTO qualified_name column_name_list? (KEY column_name_list)?
      query
    ;

merge_using_statement
    : MERGE INTO qualified_name table_alias_no_columns?
      USING table_primary
      ON expression
      merge_when_clause+
    ;

merge_when_clause
    : WHEN MATCHED (AND expression)? THEN merge_update_or_delete
    | WHEN NOT MATCHED (BY TARGET)? (AND expression)? THEN merge_insert
    ;

merge_update_or_delete
    : UPDATE SET assignment (COMMA assignment)* (WHERE expression)? (DELETE WHERE expression)?
    | DELETE
    ;

merge_insert
    : INSERT column_name_list? (OVERRIDING (USER | SYSTEM) VALUE)? VALUES row_value
    ;

call_statement
    : CALL expression
    ;

execute_immediate_statement
    : EXECUTE IMMEDIATE expression
    ;

explain_statement
    : EXPLAIN (PLAN FOR | ANALYZE)?
      (query | insert_statement | update_statement | delete_statement
      | merge_into_statement | merge_using_statement)
    ;

backup_statement
    : BACKUP TO string_literal
    ;

runscript_statement
    : RUNSCRIPT FROM string_literal file_options*
      (QUIRKS_MODE | VARIABLE_BINARY | FROM_1X)*
    ;

script_statement
    : SCRIPT script_option*
      (TO string_literal file_options*)?
      (TABLE qualified_name (COMMA qualified_name)*)?
      (SCHEMA identifier (COMMA identifier)*)?
    ;

script_option
    : NODATA
    | SIMPLE
    | COLUMNS
    | NOPASSWORDS
    | NOSETTINGS
    | DROP
    | BLOCKSIZE value_expression
    ;

file_options
    : COMPRESSION identifier
    | CIPHER identifier PASSWORD string_literal
    | CHARSET string_literal
    ;

show_statement
    : SHOW (SCHEMAS
           | TABLES (FROM identifier)?
           | COLUMNS FROM qualified_name (FROM identifier)?
           | IDENTIFIER)
    ;

help_statement
    : HELP (~SEMI)*
    ;

// ============================================================================
// Data definition: CREATE
// ============================================================================

create_statement
    : create_table_statement
    | create_linked_table_statement
    | create_view_statement
    | create_materialized_view_statement
    | create_index_statement
    | create_sequence_statement
    | create_schema_statement
    | create_alias_statement
    | create_aggregate_statement
    | create_trigger_statement
    | create_constant_statement
    | create_domain_statement
    | create_user_statement
    | create_role_statement
    | create_synonym_statement
    ;

if_not_exists
    : IF NOT EXISTS
    ;

if_exists
    : IF EXISTS
    ;

// ---------------------------------------------------------------------------
// CREATE TABLE
// ---------------------------------------------------------------------------

create_table_statement
    : CREATE (CACHED | MEMORY)? (TEMP | (GLOBAL | LOCAL)? TEMPORARY)? TABLE if_not_exists? qualified_name
      (LPAREN table_element (COMMA table_element)* RPAREN)?
      table_option*
      (AS query (WITH NO? DATA)?)?
    ;

table_element
    : table_constraint
    | mysql_index_definition
    | column_definition
    ;

table_option
    : ENGINE EQ? identifier
    | WITH identifier (COMMA identifier)*
    | NOT PERSISTENT
    | TRANSACTIONAL
    | ON COMMIT (DELETE | PRESERVE | DROP) ROWS?
    | DEFAULT? (CHARSET | CHARACTER SET) EQ? identifier
    | DEFAULT? COLLATE EQ? identifier
    | COMMENT EQ? string_literal
    | AUTO_INCREMENT EQ? value_expression
    ;

mysql_index_definition
    : (INDEX | KEY) identifier? column_name_list
    ;

column_definition
    : identifier data_type? column_attribute*
    ;

column_attribute
    : VISIBLE
    | INVISIBLE
    | DEFAULT ON NULL
    | DEFAULT expression
    | GENERATED ALWAYS AS LPAREN expression RPAREN
    | GENERATED (ALWAYS | BY DEFAULT (ON NULL)?) AS IDENTITY (LPAREN sequence_option* RPAREN)?
    | AS LPAREN expression RPAREN
    | ON UPDATE expression
    | AUTO_INCREMENT (LPAREN value_expression (COMMA value_expression)? RPAREN)?
    | IDENTITY (LPAREN value_expression (COMMA value_expression)? RPAREN)?
    | SELECTIVITY value_expression
    | COMMENT expression
    | NULL_TO_DEFAULT
    | NOT NULL
    | NULL
    | (CONSTRAINT if_not_exists? qualified_name)? column_constraint
    ;

column_constraint
    : PRIMARY KEY HASH?
    | UNIQUE nulls_distinct? KEY?
    | CHECK expression
    | references_specification
    ;

table_constraint
    : (CONSTRAINT if_not_exists? qualified_name)? table_constraint_body
    ;

table_constraint_body
    : PRIMARY KEY HASH? LPAREN index_column (COMMA index_column)* RPAREN
    | UNIQUE nulls_distinct? (KEY | INDEX)? identifier? LPAREN index_column (COMMA index_column)* RPAREN
      (INCLUDE column_name_list)?
    | FOREIGN KEY identifier? column_name_list references_specification
    | CHECK expression
    ;

nulls_distinct
    : NULLS NOT? DISTINCT
    | NULLS ALL DISTINCT
    ;

references_specification
    : REFERENCES qualified_name? column_name_list? referential_triggered_action*
    ;

referential_triggered_action
    : ON (DELETE | UPDATE) referential_action
    ;

referential_action
    : CASCADE
    | RESTRICT
    | NO ACTION
    | SET NULL
    | SET DEFAULT
    ;

index_column
    : identifier (ASC | DESC)? (NULLS (FIRST | LAST))?
    ;

// ---------------------------------------------------------------------------
// Other CREATE commands
// ---------------------------------------------------------------------------

create_linked_table_statement
    : CREATE FORCE? ((GLOBAL | LOCAL) TEMPORARY)? LINKED TABLE if_not_exists? qualified_name
      LPAREN expression_list RPAREN
      (EMIT UPDATES | READONLY)?
      (FETCH_SIZE value_expression)?
      (AUTOCOMMIT (ON | OFF))?
    ;

create_view_statement
    : CREATE (OR REPLACE)? FORCE? VIEW if_not_exists? qualified_name column_name_list?
      AS query
    ;

create_materialized_view_statement
    : CREATE (OR REPLACE)? MATERIALIZED VIEW if_not_exists? qualified_name column_name_list?
      AS query
    ;

create_index_statement
    : CREATE index_kind? INDEX if_not_exists? qualified_name?
      ON qualified_name LPAREN index_column (COMMA index_column)* RPAREN
      (INCLUDE column_name_list)?
    | CREATE PRIMARY KEY HASH? qualified_name? ON qualified_name LPAREN index_column (COMMA index_column)* RPAREN
    ;

index_kind
    : UNIQUE nulls_distinct? HASH?
    | PRIMARY KEY HASH?
    | HASH
    | SPATIAL
    ;

create_sequence_statement
    : CREATE SEQUENCE if_not_exists? qualified_name (AS data_type)? sequence_option*
    ;

sequence_option
    : START WITH? value_expression
    | RESTART (WITH? value_expression)?
    | INCREMENT BY? value_expression
    | MINVALUE value_expression
    | NO MINVALUE
    | NOMINVALUE
    | MAXVALUE value_expression
    | NO MAXVALUE
    | NOMAXVALUE
    | CYCLE
    | NO CYCLE
    | NOCYCLE
    | CACHE value_expression
    | NO CACHE
    | NOCACHE
    | EXHAUSTED
    | ORDER
    | NOORDER
    ;

create_schema_statement
    : CREATE SCHEMA if_not_exists?
      (identifier (AUTHORIZATION identifier)? | AUTHORIZATION identifier)
      (WITH identifier (COMMA identifier)*)?
    ;

create_alias_statement
    : CREATE (OR REPLACE)? FORCE? ALIAS if_not_exists? qualified_name DETERMINISTIC? NOBUFFER?
      (FOR (QUOTED_IDENTIFIER | string_literal) | AS string_literal)
    ;

create_aggregate_statement
    : CREATE AGGREGATE if_not_exists? qualified_name FOR (QUOTED_IDENTIFIER | string_literal)
    ;

create_trigger_statement
    : CREATE FORCE? TRIGGER if_not_exists? qualified_name
      (BEFORE | AFTER | INSTEAD OF) trigger_event (COMMA trigger_event)*
      ON qualified_name
      (FOR EACH (ROW | STATEMENT))?
      (QUEUE value_expression)?
      NOWAIT?
      (CALL (QUOTED_IDENTIFIER | string_literal) | AS string_literal)
    ;

trigger_event
    : INSERT
    | UPDATE
    | DELETE
    | SELECT
    | ROLLBACK
    ;

create_constant_statement
    : CREATE CONSTANT if_not_exists? qualified_name VALUE expression
    ;

create_domain_statement
    : CREATE DOMAIN if_not_exists? qualified_name AS? data_type domain_attribute*
    ;

domain_attribute
    : DEFAULT expression
    | ON UPDATE expression
    | COMMENT string_literal
    | NOT? NULL
    | (CONSTRAINT if_not_exists? qualified_name)? CHECK expression
    ;

create_user_statement
    : CREATE USER if_not_exists? identifier
      (PASSWORD string_literal | SALT literal HASH literal)
      ADMIN?
    ;

create_role_statement
    : CREATE ROLE if_not_exists? identifier
    ;

create_synonym_statement
    : CREATE (OR REPLACE)? SYNONYM if_not_exists? qualified_name FOR qualified_name
    ;

// ============================================================================
// Data definition: ALTER
// ============================================================================

alter_statement
    : alter_table_statement
    | alter_domain_statement
    | alter_index_statement
    | alter_schema_statement
    | alter_sequence_statement
    | alter_user_statement
    | alter_view_statement
    | alter_type_statement
    ;

alter_table_statement
    : ALTER TABLE if_exists? qualified_name alter_table_action (COMMA alter_table_action)*
    ;

alter_table_action
    : ADD COLUMN? if_not_exists? (column_definition | LPAREN column_definition (COMMA column_definition)* RPAREN)
      column_position?                                                       # add_column_action
    | ADD table_constraint (CHECK | NOCHECK)?                                # add_constraint_action
    | RENAME CONSTRAINT qualified_name TO identifier                             # rename_constraint_action
    | RENAME COLUMN? identifier TO identifier                                # rename_column_action
    | RENAME TO identifier                                                   # rename_table_action
    | ALTER COLUMN? if_exists? identifier alter_column_action                # alter_column_table_action
    | MODIFY COLUMN? column_definition column_position?                      # modify_column_action
    | CHANGE COLUMN? identifier column_definition column_position?           # change_column_action
    | DROP COLUMN? if_exists? (identifier (COMMA identifier)* | column_name_list) # drop_column_action
    | DROP CONSTRAINT if_exists? qualified_name (CASCADE | RESTRICT)?            # drop_constraint_action
    | DROP PRIMARY KEY                                                       # drop_primary_key_action
    | DROP (INDEX | FOREIGN KEY) identifier                                  # drop_index_action
    | SET REFERENTIAL_INTEGRITY (TRUE | FALSE) (CHECK | NOCHECK)?            # set_referential_integrity_action
    ;

column_position
    : (BEFORE | AFTER) identifier
    | FIRST
    ;

alter_column_action
    : RENAME TO identifier
    | SET DATA TYPE data_type (USING expression)?
    | SET DEFAULT ON NULL
    | DROP DEFAULT ON NULL
    | SET DEFAULT expression
    | DROP DEFAULT
    | SET ON UPDATE expression
    | DROP ON UPDATE
    | SET NOT NULL
    | DROP NOT NULL
    | SET NULL
    | SET (VISIBLE | INVISIBLE)
    | SELECTIVITY value_expression
    | DROP IDENTITY
    | DROP EXPRESSION
    | SET GENERATED (ALWAYS | BY DEFAULT) alter_identity_option*
    | alter_identity_option+
    | data_type column_attribute*
    ;

alter_identity_option
    : START WITH value_expression
    | RESTART (WITH? value_expression)?
    | SET sequence_option
    ;

alter_domain_statement
    : ALTER DOMAIN if_exists? qualified_name
      ( ADD (CONSTRAINT if_not_exists? qualified_name)? CHECK expression NOCHECK?
      | DROP CONSTRAINT if_exists? qualified_name
      | RENAME CONSTRAINT qualified_name TO identifier
      | RENAME TO identifier
      | SET DEFAULT expression
      | DROP DEFAULT
      | SET ON UPDATE expression
      | DROP ON UPDATE
      )
    ;

alter_index_statement
    : ALTER INDEX if_exists? qualified_name RENAME TO identifier
    ;

alter_schema_statement
    : ALTER SCHEMA if_exists? identifier RENAME TO identifier
    ;

alter_sequence_statement
    : ALTER SEQUENCE if_exists? qualified_name sequence_option*
    ;

alter_user_statement
    : ALTER USER identifier
      ( ADMIN (TRUE | FALSE)
      | RENAME TO identifier
      | SET (PASSWORD string_literal | SALT literal HASH literal)
      )
    ;

alter_view_statement
    : ALTER VIEW if_exists? qualified_name (RECOMPILE | RENAME TO identifier)
    ;

alter_type_statement
    : ALTER TYPE qualified_name ADD VALUE string_literal
    ;

// ============================================================================
// Data definition: DROP, TRUNCATE, COMMENT, ANALYZE
// ============================================================================

drop_statement
    : DROP TABLE if_exists? qualified_name (COMMA qualified_name)* drop_behavior?
    | DROP VIEW if_exists? qualified_name drop_behavior?
    | DROP MATERIALIZED VIEW if_exists? qualified_name
    | DROP INDEX if_exists? qualified_name
    | DROP SEQUENCE if_exists? qualified_name
    | DROP SCHEMA if_exists? identifier drop_behavior?
    | DROP ALIAS if_exists? qualified_name
    | DROP AGGREGATE if_exists? qualified_name
    | DROP TRIGGER if_exists? qualified_name
    | DROP CONSTANT if_exists? qualified_name
    | DROP DOMAIN if_exists? qualified_name drop_behavior?
    | DROP USER if_exists? identifier
    | DROP ROLE if_exists? identifier
    | DROP SYNONYM if_exists? qualified_name
    | DROP ALL OBJECTS (DELETE FILES)?
    ;

drop_behavior
    : CASCADE
    | RESTRICT
    ;

truncate_statement
    : TRUNCATE TABLE qualified_name ((CONTINUE | RESTART) IDENTITY)?
    ;

refresh_materialized_view_statement
    : REFRESH MATERIALIZED VIEW qualified_name
    ;

comment_statement
    : COMMENT ON comment_object_type qualified_name IS expression
    ;

comment_object_type
    : TABLE | VIEW | COLUMN | SCHEMA | INDEX | SEQUENCE | CONSTANT | CONSTRAINT
    | DOMAIN | TRIGGER | USER | ROLE | ALIAS
    ;

analyze_statement
    : ANALYZE (TABLE qualified_name)? (SAMPLE_SIZE value_expression)?
    ;

// ============================================================================
// Other commands: access rights, transactions, settings
// ============================================================================

grant_statement
    : GRANT ALTER ANY SCHEMA TO identifier
    | GRANT privilege (COMMA privilege)* ON (SCHEMA identifier | TABLE? qualified_name (COMMA qualified_name)*)
      TO grantee
    | GRANT identifier (COMMA identifier)* TO grantee
    ;

revoke_statement
    : REVOKE ALTER ANY SCHEMA FROM identifier
    | REVOKE privilege (COMMA privilege)* ON (SCHEMA identifier | TABLE? qualified_name (COMMA qualified_name)*)
      FROM grantee
    | REVOKE identifier (COMMA identifier)* FROM grantee
    ;

privilege
    : SELECT
    | INSERT
    | UPDATE
    | DELETE
    | ALL PRIVILEGES?
    ;

// PUBLIC is parsed as an ordinary (non-reserved) identifier.
grantee
    : identifier
    ;

transaction_statement
    : COMMIT (WORK | TRANSACTION identifier)?
    | ROLLBACK WORK? (TO SAVEPOINT identifier)?
    | ROLLBACK TRANSACTION identifier
    | SAVEPOINT identifier
    | RELEASE SAVEPOINT identifier
    | PREPARE COMMIT identifier
    | START TRANSACTION
    | BEGIN (WORK | TRANSACTION)?
    ;

checkpoint_statement
    : CHECKPOINT SYNC?
    ;

shutdown_statement
    : SHUTDOWN (IMMEDIATELY | COMPACT | DEFRAG)?
    ;

set_statement
    : SET VARIABLE (EQ | COLON_EQ) expression                                      # set_variable
    | SET SESSION CHARACTERISTICS AS TRANSACTION ISOLATION LEVEL isolation_level    # set_session_characteristics
    | SET TRANSACTION ISOLATION LEVEL isolation_level                               # set_transaction_isolation
    | SET TIME ZONE (LOCAL | expression)                                            # set_time_zone
    | SET identifier (EQ | TO)? set_argument (COMMA? set_argument)*                 # set_setting
    | SET identifier                                                                # set_setting_no_value
    ;

isolation_level
    : READ UNCOMMITTED
    | READ COMMITTED
    | REPEATABLE READ
    | SERIALIZABLE
    | SNAPSHOT
    ;

set_argument
    : expression
    | ON
    | ALL
    | PRIMARY
    | LPAREN RPAREN
    ;

// ============================================================================
// Expressions
//   OR < AND < NOT < predicates (comparison, IS, BETWEEN, IN, LIKE, ...)
//   < || < + - < * / % < unary < postfix [] < primary
// ============================================================================

expression
    : NOT expression                                     # not_expression
    | expression AND expression                          # and_expression
    | expression OR expression                           # or_expression
    | predicate                                          # predicate_expression
    ;

predicate
    : value_expression predicate_suffix*
    ;

predicate_suffix
    : comparison_operator quantifier LPAREN (query | expression) RPAREN   # quantified_comparison
    | comparison_operator value_expression                               # comparison
    | IS NOT? (NULL | TRUE | FALSE | UNKNOWN)                            # is_truth_test
    | IS NOT? (DISTINCT FROM)? quantifier LPAREN (query | expression) RPAREN # quantified_distinct
    | IS NOT? DISTINCT FROM value_expression                             # is_distinct_from
    | IS NOT? JSON json_type? (WITH | WITHOUT) UNIQUE KEYS?              # is_json_unique
    | IS NOT? JSON json_type?                                            # is_json
    | IS NOT? OF LPAREN data_type (COMMA data_type)* RPAREN               # is_of_type
    | NOT? BETWEEN (ASYMMETRIC | SYMMETRIC)? value_expression AND value_expression # between
    | NOT? IN LPAREN (query | expression_list)? RPAREN                   # in_list
    | NOT? (LIKE | ILIKE) value_expression (ESCAPE value_expression)?    # like
    | NOT? REGEXP value_expression                                       # regexp
    ;

json_type
    : VALUE
    | ARRAY
    | OBJECT
    | SCALAR
    ;

quantifier
    : ALL
    | ANY
    | SOME
    ;

comparison_operator
    : EQ | NEQ | LT | LE | GT | GE | OVERLAP
    ;

value_expression
    : value_expression LBRACKET expression RBRACKET                      # array_element_reference
    | (PLUS | MINUS_SIGN | TILDE) value_expression                       # unary_expression
    | value_expression (STAR | SLASH | PERCENT_SIGN) value_expression    # multiplicative_expression
    | value_expression (PLUS | MINUS_SIGN) value_expression              # additive_expression
    | value_expression CONCAT value_expression                           # concat_expression
    | value_expression AT (LOCAL | TIME ZONE value_expression)           # at_time_zone_expression
    | value_expression interval_qualifier                                # interval_conversion_expression
    | value_expression FORMAT JSON                                       # format_json_expression
    | primary_expression                                                 # primary
    ;

primary_expression
    : literal                                                            # literal_expression
    | parameter                                                          # parameter_expression
    | VARIABLE (COLON_EQ expression)?                                    # variable_expression
    | case_expression                                                    # case_primary
    | cast_expression                                                    # cast_primary
    | EXISTS LPAREN query RPAREN                                         # exists_expression
    | UNIQUE LPAREN query RPAREN                                         # unique_expression
    | (NEXT | CURRENT) VALUE FOR qualified_name                          # sequence_value_expression
    | ARRAY LBRACKET expression_list? RBRACKET                           # array_constructor
    | ARRAY LPAREN query RPAREN                                          # array_query_constructor
    | ROW LPAREN expression_list? RPAREN                                 # row_constructor
    | LPAREN query RPAREN                                                # scalar_subquery
    | LPAREN expression COMMA expression_list RPAREN                     # row_value_expression
    | LPAREN expression RPAREN                                           # parenthesized_expression
    | datetime_value_function                                            # datetime_function_expression
    | function_call                                                      # function_call_expression
    | DEFAULT                                                            # default_expression
    | qualified_name                                                     # column_reference
    | LPAREN (expression | query) RPAREN DOT identifier                  # field_reference
    ;

// ?, ?1 (indexed) and :name (named; used by JDBC frameworks, any word allowed)
parameter
    : PARAMETER
    | NAMED_PARAMETER
    ;

case_expression
    : CASE value_expression simple_when_clause+ (ELSE expression)? END
    | CASE searched_when_clause+ (ELSE expression)? END
    ;

simple_when_clause
    : WHEN when_operand (COMMA when_operand)* THEN expression
    ;

when_operand
    : predicate_suffix
    | expression
    ;

searched_when_clause
    : WHEN expression THEN expression
    ;

cast_expression
    : CAST LPAREN expression AS data_type (FORMAT string_literal)? RPAREN
    ;

datetime_value_function
    : (CURRENT_TIME | CURRENT_TIMESTAMP | LOCALTIME | LOCALTIMESTAMP) (LPAREN INTEGER_LITERAL? RPAREN)?
    | CURRENT_DATE (LPAREN RPAREN)?
    | (CURRENT_USER | SESSION_USER | SYSTEM_USER | CURRENT_ROLE | CURRENT_SCHEMA
      | CURRENT_CATALOG | CURRENT_PATH) (LPAREN RPAREN)?
    ;

// Generic function call. Covers built-in functions, user-defined aliases, aggregates
// (DISTINCT/ALL, ORDER BY inside the call, FILTER, WITHIN GROUP), LISTAGG options,
// JSON constructor clauses, null treatment and window (OVER) specifications.
function_call
    : function_name LPAREN function_arguments? RPAREN
      within_group_clause?
      filter_clause?
      ( FROM (FIRST | LAST) null_treatment? over_clause
      | null_treatment? over_clause?
      )
    ;

function_name
    : qualified_name
    | LEFT | RIGHT | VALUES | SET
    ;

function_arguments
    : set_quantifier_in_call? function_argument (COMMA function_argument)*
      order_by_clause?
      (SEPARATOR expression)?
      listagg_overflow?
      json_constructor_clause*
    | STAR
    | json_constructor_clause+
    ;

set_quantifier_in_call
    : DISTINCT
    | ALL
    ;

// Function argument forms, including the special keyword-separated forms used by
// EXTRACT, SUBSTRING, TRIM, POSITION, OVERLAY, CHAR_LENGTH and the JSON constructors.
function_argument
    : expression
    | (LEADING | TRAILING | BOTH) expression? (FROM expression)?
    | value_expression IN value_expression
    | expression PLACING expression FROM expression (FOR expression)?
    | expression FROM expression (FOR expression)?
    | expression FOR expression
    | expression USING (CHARACTERS | OCTETS)
    | KEY? expression (COLON | VALUE) expression
    | expression NAMED_PARAMETER   // JSON_OBJECT('key':column) written without a space
    | query (FORMAT JSON)?         // JSON_ARRAY(SELECT ... [FORMAT JSON])
    ;

json_constructor_clause
    : (NULL | ABSENT) ON NULL
    | (WITH | WITHOUT) UNIQUE KEYS?
    ;

listagg_overflow
    : ON OVERFLOW ERROR
    | ON OVERFLOW TRUNCATE string_literal? ((WITH | WITHOUT) COUNT)?
    ;

within_group_clause
    : WITHIN GROUP LPAREN order_by_clause RPAREN
    ;

filter_clause
    : FILTER LPAREN WHERE expression RPAREN
    ;

null_treatment
    : (RESPECT | IGNORE) NULLS
    ;

over_clause
    : OVER (identifier | LPAREN window_specification RPAREN)
    ;

expression_list
    : expression (COMMA expression)*
    ;

// ============================================================================
// Literals
// ============================================================================

literal
    : string_literal                                                    # character_string_literal
    | NATIONAL_STRING                                                   # national_string_literal
    | UNICODE_STRING (UESCAPE STRING)?                                  # unicode_string_literal
    | BINARY_STRING+                                                    # binary_string_literal
    | numeric_literal                                                   # number_literal
    | TRUE                                                              # true_literal
    | FALSE                                                             # false_literal
    | UNKNOWN                                                           # unknown_literal
    | NULL                                                              # null_literal
    | DATE string_literal                                               # date_literal
    | TIME (with_or_without_time_zone)? string_literal                  # time_literal
    | TIMESTAMP (with_or_without_time_zone)? string_literal             # timestamp_literal
    | INTERVAL (PLUS | MINUS_SIGN)? string_literal interval_qualifier   # interval_literal
    | JSON string_literal                                               # json_literal
    | GEOMETRY string_literal                                           # geometry_literal
    ;

string_literal
    : STRING+
    | DOLLAR_STRING
    ;

numeric_literal
    : INTEGER_LITERAL
    | DECIMAL_LITERAL
    | HEX_LITERAL
    ;

with_or_without_time_zone
    : (WITH | WITHOUT) TIME ZONE
    ;

interval_qualifier
    : interval_field (LPAREN INTEGER_LITERAL (COMMA INTEGER_LITERAL)? RPAREN)?
      (TO interval_field (LPAREN INTEGER_LITERAL RPAREN)?)?
    ;

interval_field
    : YEAR | MONTH | DAY | HOUR | MINUTE | SECOND
    ;

// ============================================================================
// Data types
// ============================================================================

data_type
    : predefined_type (ARRAY (LBRACKET INTEGER_LITERAL RBRACKET)?)*
    ;

predefined_type
    : (CHARACTER | CHAR | NATIONAL CHARACTER | NATIONAL CHAR | NCHAR) VARYING length_spec?
    | (CHARACTER | CHAR | NATIONAL CHARACTER | NATIONAL CHAR | NCHAR) LARGE OBJECT length_spec?
    | (CHARACTER | CHAR | NATIONAL CHARACTER | NATIONAL CHAR | NCHAR) length_spec?
    | BINARY VARYING length_spec?
    | BINARY LARGE OBJECT length_spec?
    | BINARY length_spec?
    | DOUBLE PRECISION?
    | TIME length_spec? with_or_without_time_zone?
    | TIMESTAMP length_spec? with_or_without_time_zone?
    | DATE
    | INTERVAL interval_qualifier
    | ROW LPAREN identifier data_type (COMMA identifier data_type)* RPAREN
    | ENUM LPAREN string_literal (COMMA string_literal)* RPAREN
    | GEOMETRY (LPAREN identifier identifier? (COMMA INTEGER_LITERAL)? RPAREN)?
    | JSON length_spec?
    | type_name length_spec? UNSIGNED?
    ;

length_spec
    : LPAREN (INTEGER_LITERAL | STAR) identifier? (COMMA MINUS_SIGN? INTEGER_LITERAL)? RPAREN
    ;

// Any other type name (INTEGER, VARCHAR, NUMERIC, DECFLOAT, VARCHAR2, NUMBER, TINYINT,
// DATETIME, LONGVARCHAR, BLOB, CLOB, ...) or a domain name.
type_name
    : identifier DOT identifier
    | IDENTIFIER
    | QUOTED_IDENTIFIER
    | BACKTICK_IDENTIFIER
    ;

// ============================================================================
// Names and identifiers
// ============================================================================

qualified_name
    : identifier (DOT identifier)*
    ;

column_name_list
    : LPAREN qualified_name (COMMA qualified_name)* RPAREN
    ;

identifier
    : IDENTIFIER
    | QUOTED_IDENTIFIER
    | BACKTICK_IDENTIFIER
    | non_reserved_keyword
    | alias_restricted_keyword
    ;

// An alias written without AS may not be one of the words that can legally follow
// an expression or a table reference.
alias_name
    : IDENTIFIER
    | QUOTED_IDENTIFIER
    | BACKTICK_IDENTIFIER
    | non_reserved_keyword
    ;

// YEAR .. SECOND are excluded because "expr DAY TO SECOND" is an interval conversion.
alias_restricted_keyword
    : AT | ESCAPE | FILTER | FORMAT | IGNORE | KEY | OVER | RESPECT | USE | WITHIN
    | YEAR | MONTH | DAY | HOUR | MINUTE | SECOND
    ;

// ----- generated: non_reserved_keyword -----
// Keywords that H2 does not reserve (or that this grammar can accept unambiguously)
// and that therefore remain usable as identifiers.
non_reserved_keyword
    : ABSENT | ACTION | ADD | ADMIN | AFTER | AGGREGATE
    | ALIAS | ALTER | ALWAYS | ANALYZE | ASC | AUTOCOMMIT
    | AUTO_INCREMENT | BACKUP | BEFORE | BEGIN | BINARY | BLOCKSIZE
    | BY | CACHE | CACHED | CALL | CASCADE | CHANGE
    | CHAR | CHARACTER | CHARACTERISTICS | CHARACTERS | CHARSET | CHECKPOINT
    | CIPHER | COLLATE | COLUMN | COLUMNS | COMMENT | COMMIT
    | COMMITTED | COMPACT | COMPRESSION | CONSTANT | CONTINUE | COUNT
    | CREATE | CURRENT | CYCLE | DATA | DATE | DEFRAG
    | DELETE | DESC | DETERMINISTIC | DIRECT | DOMAIN | DOUBLE
    | DROP | DUPLICATE | EACH | EMIT | ENGINE | ENUM
    | ERROR | EXCLUDE | EXECUTE | EXHAUSTED | EXPLAIN | EXPRESSION
    | FETCH_SIZE | FILES | FINAL | FIRST | FOLLOWING | FORCE
    | FROM_1X | GENERATED | GEOMETRY | GLOBAL | GRANT | GROUPING
    | GROUPS | HASH | HELP | IDENTITY | IMMEDIATE | IMMEDIATELY
    | INCLUDE | INCREMENT | INDEX | INSERT | INSTEAD | INTO
    | INVISIBLE | ISOLATION | JSON | KEYS | LARGE | LAST
    | LEVEL | LINKED | LOCAL | LOCKED | MATCHED | MATERIALIZED
    | MAXVALUE | MEMORY | MERGE | MINVALUE | MODIFY | NATIONAL
    | NCHAR | NEW | NEXT | NO | NOBUFFER | NOCACHE
    | NOCHECK | NOCYCLE | NODATA | NOMAXVALUE | NOMINVALUE | NOORDER
    | NOPASSWORDS | NOSETTINGS | NOWAIT | NULLS | NULL_TO_DEFAULT | OBJECT
    | OBJECTS | OCTETS | OF | OFF | OLD | ONLY
    | ORDINALITY | OTHERS | OUTER | OVERFLOW | OVERRIDING | PARTITION
    | PASSWORD | PERCENT | PERSISTENT | PLACING | PLAN | PRECEDING
    | PRECISION | PREPARE | PRESERVE | PRIVILEGES | QUEUE | QUIRKS_MODE
    | RANGE | READ | READONLY | RECOMPILE | RECURSIVE | REFERENCES
    | REFERENTIAL_INTEGRITY | REFRESH | RELEASE | RENAME | REPEATABLE | REPLACE
    | RESTART | RESTRICT | REVOKE | ROLE | ROLLBACK | ROWS
    | RUNSCRIPT | SALT | SAMPLE_SIZE | SAVEPOINT | SCALAR | SCHEMA
    | SCHEMAS | SCRIPT | SELECTIVITY | SEPARATOR | SEQUENCE | SERIALIZABLE
    | SESSION | SETS | SHOW | SHUTDOWN | SIMPLE | SKIP_
    | SNAPSHOT | SPATIAL | START | STATEMENT | SYNC | SYNONYM
    | SYSTEM | TABLES | TABLE_DISTINCT | TARGET | TEMP | TEMPORARY
    | TIES | TIME | TIMESTAMP | TOP | TRANSACTION | TRANSACTIONAL
    | TRIGGER | TRUNCATE | TYPE | UNCOMMITTED | UNSIGNED | UPDATE
    | UPDATES | USER | VALUE | VARIABLE_BINARY | VARYING | VIEW
    | VISIBLE | WAIT | WITHOUT | WORK | ZONE
    ;
