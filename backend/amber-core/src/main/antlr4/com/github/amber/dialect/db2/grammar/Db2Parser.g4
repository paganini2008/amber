/*
 * IBM Db2 for Linux, UNIX and Windows (Db2 12.1) SQL and SQL PL parser grammar.
 *
 * Written from scratch for Amber (a SQL script structure visualizer) using the
 * public IBM Db2 12.1 SQL Reference documentation as the reference:
 * https://www.ibm.com/docs/en/db2/12.1
 * No IBM source code was used.
 *
 * The grammar is deliberately permissive: it parses, it does not validate.
 * It accepts any function name with any arguments, SQL PL control statements
 * anywhere a statement is allowed, and table options in any order.
 *
 * Amber splits CLP scripts into units before parsing (terminator ';' or '@',
 * or the one set with --#SET TERMINATOR). A unit is one statement, or one
 * compound SQL PL statement (CREATE PROCEDURE ... BEGIN ... END), possibly
 * followed by ';'. The script rule also accepts several ';'-separated
 * statements, including compound statements with ';' inside their bodies.
 *
 * The keyword token list in Db2Lexer.g4 and the non_reserved_keyword rule at the
 * end of this file are generated by tools/generate_keywords.py from the tokens
 * used here.
 */
parser grammar Db2Parser;

options {
    tokenVocab = Db2Lexer;
}

// ============================================================================
// Script and statements
// ============================================================================

script
    : SEMI* (statement (SEMI+ statement)* SEMI*)? EOF
    ;

// Any statement may carry a label (used by GOTO, LEAVE and ITERATE in SQL PL).
statement
    : (label COLON)? statement_body
    ;

label
    : identifier
    ;

statement_body
    // queries and DML
    : select_statement
    | values_into_statement
    | insert_statement
    | update_statement
    | delete_statement
    | merge_statement
    | truncate_statement
    | call_statement
    // DDL
    | create_statement
    | alter_statement
    | drop_statement
    | declare_global_temporary_table_statement
    | comment_statement
    | label_on_statement
    | grant_statement
    | revoke_statement
    | rename_statement
    | refresh_table_statement
    | set_integrity_statement
    // session and transactions
    | set_statement
    | lock_table_statement
    | commit_statement
    | rollback_statement
    | savepoint_statement
    | release_savepoint_statement
    | explain_statement
    | connect_statement
    | clp_command
    // SQL PL
    | compound_statement
    | if_statement
    | case_statement
    | loop_statement
    | while_statement
    | repeat_statement
    | for_statement
    | leave_statement
    | iterate_statement
    | goto_statement
    | return_statement
    | open_statement
    | fetch_statement
    | close_statement
    | prepare_statement
    | execute_immediate_statement
    | execute_statement
    | get_diagnostics_statement
    | signal_statement
    | resignal_statement
    | allocate_cursor_statement
    | associate_locators_statement
    | pipe_statement
    ;

// ============================================================================
// Queries
// ============================================================================

// select-statement: fullselect with its optional trailing clauses
select_statement
    : query select_tail*
    ;

select_tail
    : FOR UPDATE (OF identifier (COMMA identifier)*)?
    | FOR (READ | FETCH) ONLY
    | OPTIMIZE FOR value_expression (ROW | ROWS)
    | isolation_clause
    | SKIP_ LOCKED DATA
    | WAIT FOR OUTCOME
    ;

isolation_clause
    : WITH (RR | RS | CS | UR) (USE AND KEEP (SHARE | UPDATE | EXCLUSIVE) LOCKS)?
    ;

query
    : with_clause? query_expression
    ;

with_clause
    : WITH common_table_expression (COMMA common_table_expression)*
    ;

common_table_expression
    : identifier column_name_list? AS LPAREN query RPAREN
    ;

// fullselect
query_expression
    : query_term (set_operator query_term)* order_by_clause? result_limit_clause?
    ;

set_operator
    : (UNION | EXCEPT | MINUS) (ALL | DISTINCT)?
    ;

query_term
    : query_primary (INTERSECT (ALL | DISTINCT)? query_primary)*
    ;

query_primary
    : subselect
    | LPAREN query RPAREN
    | values_clause
    ;

values_clause
    : VALUES values_row (COMMA values_row)*
    ;

values_row
    : LPAREN expression_list RPAREN
    | expression
    ;

subselect
    : select_clause
      into_clause?
      from_clause?
      where_clause?
      hierarchical_query_clause?
      group_by_clause?
      having_clause?
    ;

select_clause
    : SELECT (ALL | DISTINCT)? select_item (COMMA select_item)*
    ;

select_item
    : STAR                                       # all_columns
    | qualified_name DOT STAR                    # table_all_columns
    | expression (AS identifier | alias_name)?   # expression_item
    ;

// SELECT ... INTO (SQL PL and embedded SQL)
into_clause
    : INTO assignment_target (COMMA assignment_target)*
    ;

assignment_target
    : host_variable
    | qualified_name (LBRACKET expression RBRACKET)?
    ;

from_clause
    : FROM table_reference (COMMA table_reference)*
    ;

table_reference
    : table_primary join_part*
    ;

join_part
    : (INNER | (LEFT | RIGHT | FULL) OUTER?)? JOIN table_primary ON expression
    | CROSS JOIN table_primary
    ;

table_primary
    : qualified_name period_specification? correlation_clause? tablesample_clause?       # table_name_reference
    | (FINAL | NEW | OLD) TABLE LPAREN data_change_statement RPAREN correlation_clause?    # data_change_table_reference
    | TABLE LPAREN (function_call | query) RPAREN correlation_clause?                    # table_function_reference
    | LATERAL? LPAREN query RPAREN correlation_clause?                                  # derived_table_reference
    | UNNEST LPAREN expression_list RPAREN (WITH ORDINALITY)? correlation_clause?         # unnest_reference
    | LPAREN table_reference RPAREN                                                     # nested_join_reference
    ;

data_change_statement
    : insert_statement
    | update_statement
    | delete_statement
    | merge_statement
    ;

correlation_clause
    : (AS identifier | alias_name) column_name_list?
    ;

// Temporal tables: FOR SYSTEM_TIME / BUSINESS_TIME
period_specification
    : FOR (SYSTEM_TIME | BUSINESS_TIME)
      ( AS OF value_expression
      | FROM value_expression TO value_expression
      | BETWEEN value_expression AND value_expression
      )
    ;

tablesample_clause
    : TABLESAMPLE (BERNOULLI | SYSTEM) LPAREN expression RPAREN
      (REPEATABLE LPAREN expression RPAREN)?
    ;

where_clause
    : WHERE expression
    ;

// WHERE for UPDATE and DELETE: searched or positioned
update_where_clause
    : WHERE CURRENT OF identifier
    | WHERE expression
    ;

// Oracle-compatible hierarchical queries
hierarchical_query_clause
    : START WITH expression CONNECT BY NOCYCLE? expression
    | CONNECT BY NOCYCLE? expression (START WITH expression)?
    ;

group_by_clause
    : GROUP BY grouping_element (COMMA grouping_element)*
    ;

grouping_element
    : GROUPING SETS LPAREN grouping_element (COMMA grouping_element)* RPAREN
    | ROLLUP LPAREN grouping_element (COMMA grouping_element)* RPAREN
    | CUBE LPAREN grouping_element (COMMA grouping_element)* RPAREN
    | LPAREN RPAREN
    | expression
    ;

having_clause
    : HAVING expression
    ;

order_by_clause
    : ORDER SIBLINGS? BY sort_key (COMMA sort_key)*
    ;

sort_key
    : ORDER OF qualified_name
    | INPUT SEQUENCE
    | expression (ASC | DESC)? (NULLS (FIRST | LAST))?
    ;

result_limit_clause
    : offset_clause fetch_clause?
    | fetch_clause
    | LIMIT value_expression ((OFFSET | COMMA) value_expression)?
    ;

offset_clause
    : OFFSET value_expression (ROW | ROWS)
    ;

fetch_clause
    : FETCH (FIRST | NEXT) value_expression? (ROW | ROWS) ONLY
    ;

// ============================================================================
// Data manipulation
// ============================================================================

insert_statement
    : INSERT INTO (qualified_name | LPAREN query RPAREN) column_name_list?
      include_columns?
      (OVERRIDING (USER | SYSTEM) VALUE)?
      query
      isolation_clause?
    ;

include_columns
    : INCLUDE LPAREN identifier data_type (COMMA identifier data_type)* RPAREN
    ;

update_statement
    : UPDATE (qualified_name | LPAREN query RPAREN) period_portion? correlation_clause?
      include_columns?
      SET assignment_list
      from_clause?
      update_where_clause?
      order_by_clause?
      result_limit_clause?
      isolation_clause?
      (SKIP_ LOCKED DATA)?
    ;

// UPDATE / DELETE ... FOR PORTION OF BUSINESS_TIME FROM x TO y
period_portion
    : FOR PORTION OF BUSINESS_TIME FROM value_expression TO value_expression
    ;

assignment_list
    : assignment (COMMA assignment)*
    ;

assignment
    : assignment_target EQ cursor_value_constructor
    | assignment_target EQ expression
    | LPAREN assignment_target (COMMA assignment_target)* RPAREN EQ expression
    | ROW EQ expression
    ;

delete_statement
    : DELETE FROM (qualified_name | LPAREN query RPAREN) period_portion? correlation_clause?
      include_columns?
      update_where_clause?
      order_by_clause?
      result_limit_clause?
      isolation_clause?
      (SKIP_ LOCKED DATA)?
    ;

merge_statement
    : MERGE INTO (qualified_name | LPAREN query RPAREN) correlation_clause?
      USING table_reference
      ON expression
      merge_when_clause+
      (ELSE IGNORE)?
      isolation_clause?
    ;

merge_when_clause
    : WHEN NOT? MATCHED (AND expression)? THEN merge_action
    ;

merge_action
    : UPDATE SET assignment_list
    | DELETE
    | INSERT column_name_list? VALUES values_row (COMMA values_row)*
    | signal_statement
    ;

truncate_statement
    : TRUNCATE TABLE? qualified_name
      ((DROP | REUSE) STORAGE)?
      (IGNORE DELETE TRIGGERS | RESTRICT WHEN DELETE TRIGGERS)?
      ((CONTINUE | RESTART) IDENTITY)?
      IMMEDIATE?
    ;

call_statement
    : CALL qualified_name (LPAREN (call_argument (COMMA call_argument)*)? RPAREN)?
    ;

call_argument
    : identifier ARROW expression
    | expression
    ;

values_into_statement
    : VALUES (LPAREN expression_list RPAREN | expression) into_clause
    ;

// ============================================================================
// CREATE
// ============================================================================

create_statement
    : create_table_statement
    | create_global_temporary_table_statement
    | create_view_statement
    | create_index_statement
    | create_sequence_statement
    | create_alias_statement
    | create_schema_statement
    | create_tablespace_statement
    | create_bufferpool_statement
    | create_stogroup_statement
    | create_type_statement
    | create_function_statement
    | create_procedure_statement
    | create_trigger_statement
    | create_module_statement
    | create_variable_statement
    | create_role_statement
    | create_mask_statement
    | create_permission_statement
    ;

or_replace
    : OR REPLACE
    ;

if_not_exists
    : IF NOT EXISTS
    ;

if_exists
    : IF EXISTS
    ;

// ----------------------------------------------------------------------------
// Tables
// ----------------------------------------------------------------------------

// Regular tables and materialized query tables (CREATE TABLE ... AS (...) DATA
// INITIALLY DEFERRED REFRESH ...). Also used by CREATE SUMMARY TABLE.
create_table_statement
    : CREATE (TABLE | SUMMARY TABLE) if_not_exists? qualified_name table_contents
    ;

create_global_temporary_table_statement
    : CREATE GLOBAL TEMPORARY TABLE if_not_exists? qualified_name table_contents
    ;

declare_global_temporary_table_statement
    : DECLARE GLOBAL TEMPORARY TABLE qualified_name table_contents
    ;

table_contents
    : (LPAREN table_element (COMMA table_element)* RPAREN)?
      (LIKE qualified_name | AS LPAREN query RPAREN)?
      table_option*
    ;

table_element
    : table_constraint
    | period_definition
    | column_definition
    ;

// The data type is optional: CREATE TABLE t (a, b) AS (...) lists bare names.
column_definition
    : identifier data_type? column_option*
    ;

column_option
    : NOT NULL
    | WITH? DEFAULT default_value?
    | GENERATED (ALWAYS | BY DEFAULT) AS IDENTITY identity_options?
    | GENERATED (ALWAYS | BY DEFAULT) AS (ROW BEGIN | ROW END | TRANSACTION START ID)
    | GENERATED (ALWAYS | BY DEFAULT)? FOR EACH ROW ON UPDATE AS ROW CHANGE TIMESTAMP
    | GENERATED ALWAYS? AS LPAREN expression RPAREN
    | IMPLICITLY HIDDEN_
    | INLINE LENGTH INTEGER_LITERAL
    | COMPRESS SYSTEM DEFAULT
    | NOT? LOGGED
    | NOT? COMPACT
    | column_constraint
    ;

// A default is a constant, special register, function call or NULL; it is
// parsed as a value expression so that NOT NULL can follow it.
default_value
    : value_expression
    ;

identity_options
    : LPAREN sequence_option (COMMA? sequence_option)* RPAREN
    ;

column_constraint
    : (CONSTRAINT identifier)?
      ( PRIMARY KEY
      | UNIQUE
      | references_clause
      | CHECK LPAREN expression RPAREN
      )
      constraint_attribute*
    ;

table_constraint
    : (CONSTRAINT identifier)?
      ( PRIMARY KEY key_column_list
      | UNIQUE key_column_list
      | FOREIGN KEY column_name_list references_clause
      | CHECK LPAREN expression RPAREN
      )
      constraint_attribute*
    ;

key_column_list
    : LPAREN key_column (COMMA key_column)* RPAREN
    ;

key_column
    : identifier (WITHOUT OVERLAPS)?
    ;

references_clause
    : REFERENCES qualified_name column_name_list? referential_rule*
    ;

referential_rule
    : ON DELETE (CASCADE | SET NULL | SET DEFAULT | RESTRICT | NO ACTION)
    | ON UPDATE (CASCADE | SET NULL | RESTRICT | NO ACTION)
    ;

constraint_attribute
    : NOT? ENFORCED
    | NOT? TRUSTED
    | (ENABLE | DISABLE) QUERY OPTIMIZATION
    ;

period_definition
    : PERIOD (SYSTEM_TIME | BUSINESS_TIME) LPAREN identifier COMMA identifier RPAREN
    ;

// Table options, accepted in any order. Also covers the options of declared and
// created global temporary tables and of materialized query tables.
table_option
    : IN identifier (COMMA identifier)*
    | INDEX IN identifier
    | LONG IN identifier
    | ORGANIZE BY (ROW | COLUMN) (USING LPAREN INSERT TIME RPAREN)?
    | ORGANIZE BY INSERT TIME
    | ORGANIZE BY DIMENSIONS? LPAREN dimension (COMMA dimension)* RPAREN
    | ORGANIZE BY KEY SEQUENCE LPAREN key_sequence_column (COMMA key_sequence_column)* RPAREN
      ((ALLOW | DISALLOW) OVERFLOW)? (PCTFREE INTEGER_LITERAL)?
    | DISTRIBUTE BY (HASH column_name_list | RANDOM | REPLICATION)
    | PARTITIONING KEY column_name_list (USING HASHING)?
    | partition_by_clause
    | COMPRESS (YES (ADAPTIVE | STATIC)? | NO)
    | VALUE COMPRESSION
    | WITH RESTRICT ON DROP
    | NOT LOGGED INITIALLY
    | NOT LOGGED (ON ROLLBACK (DELETE | PRESERVE) ROWS)?
    | LOGGED
    | DATA CAPTURE (NONE | CHANGES (INCLUDE LONGVAR COLUMNS)?)
    | CCSID (ASCII | UNICODE | EBCDIC)
    | APPEND (ON | OFF)
    | NOT? VOLATILE CARDINALITY?
    | ON COMMIT (DELETE | PRESERVE | DROP) ROWS
    | WITH REPLACE
    | WITH NO? DATA
    | DEFINITION ONLY
    | DATA INITIALLY (DEFERRED | IMMEDIATE)
    | REFRESH (DEFERRED | IMMEDIATE)
    | (ENABLE | DISABLE) QUERY OPTIMIZATION
    | MAINTAINED BY (SYSTEM | USER | FEDERATED_TOOL | REPLICATION)
    | (INCLUDING | EXCLUDING) COLUMN? DEFAULTS
    | (INCLUDING | EXCLUDING) IDENTITY (COLUMN ATTRIBUTES)?
    | SECURITY POLICY identifier
    | PCTFREE INTEGER_LITERAL
    | LOCKSIZE (ROW | TABLE | BLOCKINSERT)
    ;

dimension
    : identifier
    | LPAREN identifier (COMMA identifier)* RPAREN
    ;

key_sequence_column
    : identifier STARTING FROM? signed_number ENDING AT? signed_number
    ;

partition_by_clause
    : PARTITION BY RANGE? LPAREN partition_expression (COMMA partition_expression)* RPAREN
      LPAREN partition_element (COMMA partition_element)* RPAREN
    ;

partition_expression
    : identifier (NULLS (FIRST | LAST))?
    ;

partition_element
    : (PARTITION identifier)? partition_boundary partition_storage_option*
    ;

partition_boundary
    : STARTING FROM? partition_bound (INCLUSIVE | EXCLUSIVE)?
      (ENDING AT? partition_bound (INCLUSIVE | EXCLUSIVE)?)?
      (EVERY value_expression)?
    | ENDING AT? partition_bound (INCLUSIVE | EXCLUSIVE)?
    ;

partition_bound
    : LPAREN partition_bound_value (COMMA partition_bound_value)* RPAREN
    | partition_bound_value
    ;

partition_bound_value
    : MINVALUE
    | MAXVALUE
    | value_expression
    ;

partition_storage_option
    : IN identifier
    | INDEX IN identifier
    | LONG IN identifier
    ;

// ----------------------------------------------------------------------------
// Views, indexes, sequences, aliases, schemas
// ----------------------------------------------------------------------------

create_view_statement
    : CREATE or_replace? VIEW qualified_name column_name_list? AS query
      (WITH (CASCADED | LOCAL)? CHECK OPTION)?
    ;

create_index_statement
    : CREATE UNIQUE? INDEX if_not_exists? qualified_name ON qualified_name
      LPAREN index_key (COMMA index_key)* RPAREN
      index_option*
    ;

index_key
    : BUSINESS_TIME WITHOUT OVERLAPS
    | expression (ASC | DESC | RANDOM)?
    ;

index_option
    : NOT? PARTITIONED
    | IN identifier
    | SPECIFICATION ONLY
    | INCLUDE column_name_list
    | EXCLUDE NULL KEYS
    | INCLUDE NULL KEYS
    | CLUSTER
    | PCTFREE INTEGER_LITERAL
    | LEVEL2 PCTFREE INTEGER_LITERAL
    | MINPCTUSED INTEGER_LITERAL
    | (ALLOW | DISALLOW) REVERSE SCANS
    | PAGE SPLIT (SYMMETRIC | HIGH | LOW)
    | COLLECT SAMPLED? DETAILED? STATISTICS
    | COMPRESS (YES | NO)
    ;

create_sequence_statement
    : CREATE or_replace? SEQUENCE qualified_name sequence_option*
    ;

sequence_option
    : AS data_type
    | START WITH signed_number
    | INCREMENT BY signed_number
    | MINVALUE signed_number
    | MAXVALUE signed_number
    | NO (MINVALUE | MAXVALUE | CYCLE | CACHE | ORDER)
    | NOMINVALUE | NOMAXVALUE | NOCYCLE | NOCACHE | NOORDER
    | CYCLE
    | CACHE INTEGER_LITERAL
    | ORDER
    | RESTART (WITH signed_number)?
    ;

signed_number
    : (PLUS | MINUS_SIGN)? (INTEGER_LITERAL | DECIMAL_LITERAL)
    ;

create_alias_statement
    : CREATE or_replace? PUBLIC? (ALIAS | SYNONYM) qualified_name
      FOR (TABLE | MODULE | SEQUENCE)? qualified_name
    ;

create_schema_statement
    : CREATE SCHEMA if_not_exists?
      (qualified_name (AUTHORIZATION identifier)? | AUTHORIZATION identifier)
      (DATA CAPTURE (NONE | CHANGES))?
      schema_element*
    ;

// Statements embedded in CREATE SCHEMA (no terminators between them)
schema_element
    : create_table_statement
    | create_view_statement
    | create_index_statement
    | comment_statement
    | grant_statement
    ;

// ----------------------------------------------------------------------------
// Storage: tablespaces, buffer pools, storage groups
// ----------------------------------------------------------------------------

create_tablespace_statement
    : CREATE (LARGE | REGULAR | (SYSTEM | USER)? TEMPORARY)? TABLESPACE identifier
      tablespace_option*
    ;

tablespace_option
    : IN (DATABASE PARTITION GROUP | NODEGROUP)? identifier
    | PAGESIZE size_value
    | MANAGED BY AUTOMATIC STORAGE
    | MANAGED BY SYSTEM USING LPAREN string_literal (COMMA string_literal)* RPAREN
    | MANAGED BY DATABASE USING LPAREN container (COMMA container)* RPAREN
    | USING STOGROUP identifier
    | AUTORESIZE (YES | NO)
    | INITIALSIZE size_value
    | INCREASESIZE INTEGER_LITERAL (PERCENT | identifier)?
    | MAXSIZE (size_value | NONE)
    | EXTENTSIZE size_value
    | PREFETCHSIZE (AUTOMATIC | size_value)
    | BUFFERPOOL identifier
    | OVERHEAD (numeric_literal | INHERIT)
    | TRANSFERRATE (numeric_literal | INHERIT)
    | NO? FILE SYSTEM CACHING
    | DROPPED TABLE RECOVERY (ON | OFF)
    | DATA TAG (INTEGER_LITERAL | INHERIT | NONE)
    ;

container
    : (FILE | DEVICE) string_literal size_value
    ;

// 4096, 32 K, 100 M, 2 G (written 32K, 100M, 2G)
size_value
    : INTEGER_LITERAL identifier?
    ;

create_bufferpool_statement
    : CREATE BUFFERPOOL identifier bufferpool_option*
    ;

bufferpool_option
    : IMMEDIATE
    | DEFERRED
    | ALL DBPARTITIONNUMS
    | DATABASE PARTITION GROUP identifier (COMMA identifier)*
    | SIZE (INTEGER_LITERAL AUTOMATIC? | AUTOMATIC)
    | NUMBLOCKPAGES INTEGER_LITERAL (BLOCKSIZE INTEGER_LITERAL)?
    | PAGESIZE size_value
    | NOT? EXTENDED STORAGE
    | DBPARTITIONNUM INTEGER_LITERAL
    ;

create_stogroup_statement
    : CREATE STOGROUP identifier ON string_literal (COMMA string_literal)* stogroup_option*
    ;

stogroup_option
    : OVERHEAD numeric_literal
    | DEVICE READ RATE numeric_literal
    | DATA TAG (INTEGER_LITERAL | NONE)
    | SET AS DEFAULT
    ;

// ----------------------------------------------------------------------------
// User-defined types, variables, roles, row and column access control
// ----------------------------------------------------------------------------

create_type_statement
    : CREATE or_replace? type_definition
    ;

type_definition
    : TYPE qualified_name (UNDER qualified_name)? AS
      ( LPAREN field_definition (COMMA field_definition)* RPAREN     // structured type
      | qualified_name? CURSOR                                       // cursor type
      | data_type (WITH COMPARISONS)?                                // distinct, array, row type
      )
      type_option*
    ;

type_option
    : NOT? INSTANTIABLE
    | NOT? FINAL
    | MODE_ DB2SQL
    | WITH FUNCTION ACCESS
    | WITHOUT COMPARISONS
    | INLINE LENGTH INTEGER_LITERAL
    | REF USING data_type
    ;

field_definition
    : identifier data_type
    ;

create_variable_statement
    : CREATE or_replace? variable_definition
    ;

variable_definition
    : VARIABLE qualified_name data_type ((DEFAULT | CONSTANT) expression)?
    ;

create_role_statement
    : CREATE ROLE identifier
    ;

create_mask_statement
    : CREATE or_replace? MASK qualified_name ON qualified_name (AS? alias_name)?
      FOR COLUMN identifier RETURN expression (ENABLE | DISABLE)?
    ;

create_permission_statement
    : CREATE or_replace? PERMISSION qualified_name ON qualified_name (AS? alias_name)?
      FOR ROWS WHERE expression ENFORCED FOR ALL ACCESS (ENABLE | DISABLE)?
    ;

// ----------------------------------------------------------------------------
// Routines: functions and procedures
// ----------------------------------------------------------------------------

create_function_statement
    : CREATE or_replace? function_definition
    ;

function_definition
    : FUNCTION qualified_name LPAREN (parameter_declaration (COMMA parameter_declaration)*)? RPAREN
      RETURNS returns_clause
      routine_option*
      routine_body?
    ;

returns_clause
    : GENERIC? TABLE LPAREN field_definition (COMMA field_definition)* RPAREN
    | GENERIC TABLE
    | data_type (CAST FROM data_type)? (AS LOCATOR)?
    ;

create_procedure_statement
    : CREATE or_replace? procedure_definition
    ;

procedure_definition
    : PROCEDURE qualified_name (LPAREN (parameter_declaration (COMMA parameter_declaration)*)? RPAREN)?
      routine_option*
      routine_body?
    ;

// The name is optional in function signatures: CREATE FUNCTION f(INTEGER) ...
parameter_declaration
    : (IN | OUT | INOUT)? (data_type | identifier data_type) (AS LOCATOR)? (DEFAULT expression)?
    ;

routine_option
    : LANGUAGE identifier
    | SPECIFIC qualified_name
    | NOT? DETERMINISTIC
    | NO EXTERNAL ACTION
    | EXTERNAL ACTION
    | EXTERNAL NAME (string_literal | qualified_name)
    | EXTERNAL
    | READS SQL DATA
    | MODIFIES SQL DATA
    | CONTAINS SQL
    | NO SQL
    | CALLED ON NULL INPUT
    | RETURNS NULL ON NULL INPUT
    | NOT? NULL CALL
    | INHERIT SPECIAL REGISTERS
    | STATIC DISPATCH
    | PARAMETER STYLE identifier (WITH NULLS)?
    | PARAMETER CCSID (ASCII | UNICODE | EBCDIC)
    | NOT? FENCED
    | NOT? THREADSAFE
    | NOT? SECURED
    | (ALLOW | DISALLOW) PARALLEL
    | NO? DBINFO
    | NO SCRATCHPAD
    | SCRATCHPAD INTEGER_LITERAL?
    | NO? FINAL CALL
    | CARDINALITY INTEGER_LITERAL
    | TRANSFORM GROUP identifier
    | DYNAMIC? RESULT SETS INTEGER_LITERAL
    | COMMIT ON RETURN (YES | NO)
    | AUTONOMOUS
    | (OLD | NEW) SAVEPOINT LEVEL
    | PROGRAM TYPE (SUB | MAIN)
    | SOURCE qualified_name (LPAREN (data_type (COMMA data_type)*)? RPAREN)?
    | PIPELINED
    ;

// SQL routine body: RETURN ..., a compound statement or a single statement
routine_body
    : statement
    ;

// ----------------------------------------------------------------------------
// Triggers
// ----------------------------------------------------------------------------

create_trigger_statement
    : CREATE or_replace? TRIGGER qualified_name trigger_time
      trigger_event (OR trigger_event)* ON qualified_name
      trigger_option*
      statement
    ;

trigger_time
    : NO CASCADE BEFORE
    | BEFORE
    | AFTER
    | INSTEAD OF
    ;

trigger_event
    : INSERT
    | DELETE
    | UPDATE (OF identifier (COMMA identifier)*)?
    ;

trigger_option
    : REFERENCING referencing_item+
    | FOR EACH (ROW | STATEMENT)
    | MODE_ DB2SQL
    | NOT? SECURED
    | WHEN LPAREN expression RPAREN
    ;

referencing_item
    : (OLD | NEW) TABLE AS? identifier
    | (OLD | NEW) ROW? AS? identifier
    | (OLD_TABLE | NEW_TABLE) AS? identifier
    ;

// ----------------------------------------------------------------------------
// Modules
// ----------------------------------------------------------------------------

create_module_statement
    : CREATE or_replace? MODULE qualified_name
    ;

alter_module_statement
    : ALTER MODULE qualified_name (PUBLISH | ADD) module_object
    | ALTER MODULE qualified_name DROP (BODY | module_object_reference)
    ;

module_object
    : procedure_definition
    | function_definition
    | type_definition
    | variable_definition
    | CONDITION identifier FOR SQLSTATE VALUE? string_literal
    ;

module_object_reference
    : (SPECIFIC? (PROCEDURE | FUNCTION) | TYPE | VARIABLE | CONDITION) qualified_name
      (LPAREN (data_type (COMMA data_type)*)? RPAREN)?
    ;

// ============================================================================
// ALTER
// ============================================================================

alter_statement
    : alter_table_statement
    | alter_sequence_statement
    | alter_tablespace_statement
    | alter_bufferpool_statement
    | alter_view_statement
    | alter_index_statement
    | alter_module_statement
    | alter_routine_statement
    ;

alter_table_statement
    : ALTER TABLE qualified_name alter_table_action+
    ;

alter_table_action
    : ADD COLUMN? column_definition
    | ADD table_constraint
    | ADD period_definition
    | ADD PARTITION identifier? partition_boundary partition_storage_option*
    | ADD VERSIONING USE HISTORY TABLE qualified_name
    | ADD MATERIALIZED? QUERY LPAREN query RPAREN table_option*
    | ADD RESTRICT ON DROP
    | ADD SECURITY POLICY identifier
    | ALTER COLUMN? identifier alter_column_action+
    | ALTER (FOREIGN KEY | CHECK | CONSTRAINT) identifier constraint_attribute+
    | DROP COLUMN? identifier (CASCADE | RESTRICT)?
    | DROP PRIMARY KEY
    | DROP (FOREIGN KEY | UNIQUE | CHECK | CONSTRAINT) identifier
    | DROP VERSIONING
    | DROP RESTRICT ON DROP
    | DROP MATERIALIZED? QUERY
    | DROP PERIOD (SYSTEM_TIME | BUSINESS_TIME)
    | RENAME COLUMN identifier TO identifier
    | ATTACH PARTITION identifier? partition_boundary FROM qualified_name
      ((BUILD MISSING | REQUIRE MATCHING) INDEXES)?
    | DETACH PARTITION identifier INTO qualified_name
    | ACTIVATE NOT LOGGED INITIALLY (WITH EMPTY TABLE)?
    | (ACTIVATE | DEACTIVATE) (VALUE COMPRESSION | ROW ACCESS CONTROL | COLUMN ACCESS CONTROL)
    | table_option
    ;

alter_column_action
    : SET DATA TYPE data_type
    | SET DEFAULT default_value
    | SET NOT NULL
    | SET INLINE LENGTH INTEGER_LITERAL
    | SET EXPRESSION AS LPAREN expression RPAREN
    | SET GENERATED (ALWAYS | BY DEFAULT)? (AS IDENTITY identity_options? | AS LPAREN expression RPAREN)?
    | SET (NOT | IMPLICITLY) HIDDEN_
    | SET NOT? LOGGED
    | SET sequence_option
    | DROP (DEFAULT | NOT NULL | IDENTITY | GENERATED | EXPRESSION)
    | RESTART (WITH signed_number)?
    | COMPRESS (SYSTEM DEFAULT | OFF)
    | ADD SCOPE qualified_name
    ;

alter_sequence_statement
    : ALTER SEQUENCE qualified_name sequence_option+
    ;

alter_tablespace_statement
    : ALTER TABLESPACE identifier alter_tablespace_option+
    ;

alter_tablespace_option
    : (ADD | BEGIN NEW STRIPE SET | EXTEND | RESIZE | REDUCE | DROP)
      LPAREN container (COMMA container)* RPAREN
    | (EXTEND | RESIZE) LPAREN ALL CONTAINERS? size_value RPAREN
    | REDUCE (MAX | STOP | size_value)?
    | LOWER HIGH WATER MARK (STOP)?
    | REBALANCE (SUSPEND | RESUME)?
    | SWITCH ONLINE
    | CONVERT TO LARGE
    | tablespace_option
    ;

alter_bufferpool_statement
    : ALTER BUFFERPOOL identifier bufferpool_option+
    ;

alter_view_statement
    : ALTER VIEW qualified_name ((ENABLE | DISABLE) QUERY OPTIMIZATION
      | ALTER COLUMN? identifier ADD SCOPE qualified_name)
    ;

alter_index_statement
    : ALTER INDEX qualified_name COMPRESS (YES | NO)
    ;

alter_routine_statement
    : ALTER (SPECIFIC? (PROCEDURE | FUNCTION)) qualified_name
      (LPAREN (data_type (COMMA data_type)*)? RPAREN)? routine_option+
    ;

// ============================================================================
// DROP, COMMENT, LABEL, RENAME, REFRESH, SET INTEGRITY
// ============================================================================

drop_statement
    : DROP TABLESPACE if_exists? identifier (COMMA identifier)*
    | DROP TABLESPACES identifier (COMMA identifier)*
    | DROP drop_object_type if_exists? qualified_name
      (LPAREN (data_type (COMMA data_type)*)? RPAREN)?
      (CASCADE | RESTRICT)?
    ;

drop_object_type
    : TABLE HIERARCHY?
    | VIEW HIERARCHY?
    | INDEX
    | SEQUENCE
    | PUBLIC? (ALIAS | SYNONYM)
    | SCHEMA
    | BUFFERPOOL
    | STOGROUP
    | TYPE
    | SPECIFIC? FUNCTION
    | SPECIFIC? PROCEDURE
    | TRIGGER
    | MODULE
    | VARIABLE
    | ROLE
    | MASK
    | PERMISSION
    | NICKNAME
    | PACKAGE
    | SERVER
    | WRAPPER
    | EVENT MONITOR
    | WORKLOAD
    | SERVICE CLASS
    ;

comment_statement
    : COMMENT ON comment_target IS string_literal
    | COMMENT ON qualified_name LPAREN column_comment (COMMA column_comment)* RPAREN
    ;

comment_target
    : COLUMN qualified_name
    | CONSTRAINT qualified_name
    | comment_object_type qualified_name (LPAREN (data_type (COMMA data_type)*)? RPAREN)?
    ;

comment_object_type
    : TABLE
    | VIEW
    | INDEX
    | SCHEMA
    | PUBLIC? (ALIAS | SYNONYM)
    | SEQUENCE
    | TRIGGER
    | TYPE
    | SPECIFIC? FUNCTION
    | SPECIFIC? PROCEDURE
    | TABLESPACE
    | BUFFERPOOL
    | STOGROUP
    | MODULE
    | VARIABLE
    | ROLE
    | MASK
    | PERMISSION
    | PACKAGE
    | NICKNAME
    | SERVER
    | WRAPPER
    | DATABASE PARTITION GROUP
    | WORKLOAD
    | SERVICE CLASS
    ;

column_comment
    : identifier IS string_literal
    ;

label_on_statement
    : LABEL ON (TABLE | ALIAS | COLUMN | INDEX | SEQUENCE | PROCEDURE | FUNCTION | TRIGGER)?
      qualified_name IS string_literal
    | LABEL ON qualified_name LPAREN column_comment (COMMA column_comment)* RPAREN
    ;

rename_statement
    : RENAME TABLE? qualified_name TO identifier
    | RENAME (INDEX | TABLESPACE | STOGROUP) qualified_name TO identifier
    ;

refresh_table_statement
    : REFRESH TABLE qualified_name (COMMA qualified_name)*
      (ALLOW (NO | READ | WRITE) ACCESS)?
      (USE SYSTEM QUERIES)?
      (NOT? INCREMENTAL)?
    ;

set_integrity_statement
    : SET INTEGRITY FOR qualified_name integrity_option* (COMMA qualified_name integrity_option*)*
    ;

integrity_option
    : OFF (CASCADE (IMMEDIATE | DEFERRED))?
    | IMMEDIATE (CHECKED | UNCHECKED)
    | ALL IMMEDIATE UNCHECKED
    | (FOREIGN KEY | CHECK | MATERIALIZED QUERY | GENERATED COLUMN | STAGING) IMMEDIATE? UNCHECKED?
    | FULL ACCESS
    | (ALLOW | NO) (NO | READ | WRITE)? ACCESS
    | PRUNE
    | NOT? INCREMENTAL
    | FOR EXCEPTION IN qualified_name USE qualified_name (COMMA IN qualified_name USE qualified_name)*
    ;

// ============================================================================
// GRANT and REVOKE
// ============================================================================

grant_statement
    : GRANT USE OF TABLESPACE identifier TO grantee_list (WITH GRANT OPTION)?
    | GRANT privilege_list (ON grant_object)? TO grantee_list
      (WITH (GRANT | ADMIN) OPTION)?
    ;

revoke_statement
    : REVOKE USE OF TABLESPACE identifier FROM grantee_list (BY ALL)?
    | REVOKE (ADMIN OPTION FOR)? privilege_list (ON grant_object)? FROM grantee_list
      (BY ALL)? RESTRICT?
    ;

privilege_list
    : privilege (COMMA privilege)*
    ;

privilege
    : ALL PRIVILEGES?
    | (SELECT | INSERT | UPDATE | DELETE | ALTER | INDEX | REFERENCES | EXECUTE | USAGE | CONTROL)
      column_name_list?
    | ROLE identifier
    | identifier     // DBADM, CONNECT, CREATETAB, CREATEIN, BINDADD, LOAD, SECADM, role names, ...
    ;

grant_object
    : DATABASE
    | grant_object_type? qualified_name (DOT STAR)? (LPAREN (data_type (COMMA data_type)*)? RPAREN)?
    ;

grant_object_type
    : TABLE
    | INDEX
    | SEQUENCE
    | SCHEMA
    | SPECIFIC? (FUNCTION | PROCEDURE)
    | MODULE
    | VARIABLE
    | PACKAGE
    | TABLESPACE
    | WORKLOAD
    | SERVER
    | NICKNAME
    | TYPE
    | USER
    ;

grantee_list
    : grantee (COMMA grantee)*
    ;

grantee
    : PUBLIC
    | (USER | GROUP | ROLE)? identifier
    ;

// ============================================================================
// SET, locks, transactions, EXPLAIN, CONNECT, CLP commands
// ============================================================================

set_statement
    : SET CURRENT? (SCHEMA | SQLID) EQ? expression                                 # set_schema
    | SET CURRENT? FUNCTION? PATH EQ? path_element (COMMA path_element)*            # set_path
    | SET CURRENT special_register_name EQ? set_register_value                     # set_special_register
    | SET ENCRYPTION PASSWORD EQ? expression (WITH HINT EQ? expression)?            # set_encryption_password
    | SET SESSION AUTHORIZATION EQ? expression (ALLOW ADMINISTRATION)?              # set_session_authorization
    | SET assignment_list                                                           # set_assignment
    ;

path_element
    : SYSTEM PATH
    | CURRENT FUNCTION? PATH
    | host_variable
    | string_literal
    | identifier
    ;

set_register_value
    : NOT WAIT
    | WAIT expression?
    | ANY
    | ALL
    | expression (COMMA expression)*
    ;

lock_table_statement
    : LOCK TABLE qualified_name IN (SHARE | EXCLUSIVE) MODE_
    ;

commit_statement
    : COMMIT WORK?
    ;

rollback_statement
    : ROLLBACK WORK? (TO SAVEPOINT identifier?)?
    ;

savepoint_statement
    : SAVEPOINT identifier UNIQUE? (ON ROLLBACK RETAIN (CURSORS | LOCKS))*
    ;

release_savepoint_statement
    : RELEASE TO? SAVEPOINT identifier?
    ;

explain_statement
    : EXPLAIN (PLAN SELECTION | PLAN | ALL)? explain_option* FOR statement
    ;

explain_option
    : SET (QUERYNO | QUERYTAG) EQ literal
    | (WITH | FOR) SNAPSHOT
    | WITH REOPT ONCE
    ;

connect_statement
    : CONNECT (TO identifier (USER identifier USING expression)? | RESET)?
    | DISCONNECT (ALL | CURRENT | identifier)
    | TERMINATE
    ;

// Common CLP commands that appear in Db2 scripts. They are not SQL; their
// arguments are accepted as an unstructured token list.
clp_command
    : (RUNSTATS | REORG | REORGCHK | EXPORT | IMPORT | LOAD | DESCRIBE) clp_token*
    ;

clp_token
    : ~SEMI
    ;

// ============================================================================
// SQL PL: compound statements and declarations
// ============================================================================

// BEGIN [NOT] ATOMIC ... END [label]. Declarations and statements are each
// terminated by ';'.
compound_statement
    : BEGIN (NOT? ATOMIC)? (compound_item SEMI+)* END label?
    ;

compound_item
    : declaration
    | statement
    ;

declaration
    : DECLARE identifier (COMMA identifier)* data_type ((DEFAULT | CONSTANT) expression)?     # variable_declaration
    | DECLARE identifier CONDITION (FOR (SQLSTATE VALUE? string_literal | SQLCODE? signed_number))? # condition_declaration
    | DECLARE identifier (ASENSITIVE | INSENSITIVE)? CURSOR cursor_option*
      FOR (select_statement | identifier)                                                      # cursor_declaration
    | DECLARE (CONTINUE | EXIT | UNDO) HANDLER FOR condition_value (COMMA condition_value)*
      statement                                                                               # handler_declaration
    ;

cursor_option
    : WITH HOLD
    | WITHOUT HOLD
    | WITH RETURN (TO (CALLER | CLIENT))?
    | WITHOUT RETURN
    ;

condition_value
    : SQLEXCEPTION
    | SQLWARNING
    | NOT FOUND
    | SQLSTATE VALUE? string_literal
    | identifier
    ;

// ============================================================================
// SQL PL: control statements
// ============================================================================

statement_list
    : (statement SEMI+)+
    ;

if_statement
    : IF expression THEN statement_list
      (ELSEIF expression THEN statement_list)*
      (ELSE statement_list)?
      END IF
    ;

case_statement
    : CASE expression (WHEN expression THEN statement_list)+ (ELSE statement_list)? END CASE
    | CASE (WHEN expression THEN statement_list)+ (ELSE statement_list)? END CASE
    ;

loop_statement
    : LOOP statement_list END LOOP label?
    ;

while_statement
    : WHILE expression DO statement_list END WHILE label?
    ;

repeat_statement
    : REPEAT statement_list UNTIL expression END REPEAT label?
    ;

for_statement
    : FOR identifier AS (identifier (ASENSITIVE | INSENSITIVE)? CURSOR cursor_option* FOR)?
      select_statement DO statement_list END FOR label?
    ;

leave_statement
    : LEAVE label
    ;

iterate_statement
    : ITERATE label
    ;

goto_statement
    : GOTO label
    ;

return_statement
    : RETURN (expression | query)?
    ;

open_statement
    : OPEN identifier (FOR (select_statement | identifier))? (USING expression_list)?
    ;

fetch_statement
    : FETCH NEXT? FROM? identifier (INTO assignment_target (COMMA assignment_target)*)?
    ;

close_statement
    : CLOSE identifier (WITH RELEASE)?
    ;

prepare_statement
    : PREPARE identifier (OUTPUT? INTO identifier)? FROM expression
    ;

execute_statement
    : EXECUTE identifier into_clause? (USING expression_list)?
    ;

execute_immediate_statement
    : EXECUTE IMMEDIATE expression
    ;

get_diagnostics_statement
    : GET (CURRENT | STACKED)? DIAGNOSTICS (EXCEPTION value_expression)?
      diagnostics_item (COMMA diagnostics_item)*
    ;

diagnostics_item
    : assignment_target EQ identifier
    ;

signal_statement
    : SIGNAL signal_condition signal_information?
    ;

resignal_statement
    : RESIGNAL (signal_condition signal_information?)?
    ;

signal_condition
    : SQLSTATE VALUE? value_expression
    | identifier
    ;

signal_information
    : SET identifier EQ expression (COMMA identifier EQ expression)*
    | LPAREN expression RPAREN
    ;

// SET cv = CURSOR [WITH HOLD] FOR select-statement (cursor variables)
cursor_value_constructor
    : CURSOR cursor_option* FOR select_statement
    ;

allocate_cursor_statement
    : ALLOCATE identifier CURSOR FOR RESULT SET identifier
    ;

associate_locators_statement
    : ASSOCIATE (RESULT SET)? (LOCATOR | LOCATORS) LPAREN identifier (COMMA identifier)* RPAREN
      WITH PROCEDURE qualified_name
    ;

pipe_statement
    : PIPE expression
    ;

// ============================================================================
// Expressions
// ============================================================================

expression
    : NOT expression                    # not_expression
    | expression AND expression         # and_expression
    | expression OR expression          # or_expression
    | predicate                         # predicate_expression
    ;

predicate
    : value_expression predicate_suffix?
    ;

predicate_suffix
    : comparison_operator (ALL | ANY | SOME) LPAREN query RPAREN               # quantified_comparison
    | comparison_operator value_expression                                     # comparison
    | IS NOT? NULL                                                             # null_test
    | IS NOT? (TRUE | FALSE | UNKNOWN)                                         # truth_test
    | IS NOT? DISTINCT FROM value_expression                                   # distinct_test
    | IS NOT? OF LPAREN ONLY? data_type (COMMA ONLY? data_type)* RPAREN        # type_test
    | NOT? BETWEEN value_expression AND value_expression                       # between
    | NOT? IN LPAREN (query | expression_list) RPAREN                          # in_list
    | NOT? IN value_expression                                                 # in_expression
    | NOT? LIKE value_expression (ESCAPE value_expression)?                    # like
    ;

comparison_operator
    : EQ | NEQ | LT | LE | GT | GE
    ;

// Precedence from tightest to loosest: [] and labeled durations, prefix
// operators, * / || CONCAT, + -. (Db2 evaluates concatenation at the level of
// multiplication and division.)
value_expression
    : value_expression LBRACKET expression RBRACKET                          # array_element_expression
    | value_expression duration_unit                                         # labeled_duration_expression
    | (PLUS | MINUS_SIGN) value_expression                                   # unary_expression
    | (PRIOR | CONNECT_BY_ROOT) value_expression                             # hierarchical_operator_expression
    | value_expression (STAR | SLASH | CONCAT_OP | CONCAT) value_expression  # multiplicative_expression
    | value_expression (PLUS | MINUS_SIGN) value_expression                  # additive_expression
    | primary_expression                                                     # primary
    ;

duration_unit
    : YEAR | YEARS | MONTH | MONTHS | DAY | DAYS | HOUR | HOURS
    | MINUTE | MINUTES | SECOND | SECONDS | MICROSECOND | MICROSECONDS
    ;

primary_expression
    : literal                                                            # literal_expression
    | host_variable                                                      # host_variable_expression
    | QUESTION                                                           # parameter_marker
    | case_expression                                                    # case_primary
    | cast_expression                                                    # cast_primary
    | EXISTS LPAREN query RPAREN                                         # exists_expression
    | (NEXT | PREVIOUS) VALUE FOR qualified_name                         # sequence_reference
    | (NEXTVAL | PREVVAL) FOR qualified_name                             # sequence_reference_short
    | ROW CHANGE (TIMESTAMP | TOKEN) FOR qualified_name                  # row_change_expression
    | ARRAY LBRACKET (query | expression_list)? RBRACKET                 # array_constructor
    | special_register                                                   # special_register_expression
    | LPAREN query RPAREN                                                # scalar_subquery
    | LPAREN expression COMMA expression_list RPAREN                     # row_value_expression
    | LPAREN expression RPAREN                                           # parenthesized_expression
    | function_call                                                      # function_call_expression
    | DEFAULT                                                            # default_expression
    | qualified_name                                                     # column_reference
    ;

// :name, :name:indicator, :name INDICATOR :indicator
host_variable
    : COLON identifier (INDICATOR? COLON identifier)?
    ;

special_register
    : CURRENT special_register_name
    ;

// CURRENT_DATE, CURRENT_TIMESTAMP, USER, SESSION_USER, ... are parsed as names.
special_register_name
    : DATE
    | TIME ZONE
    | TIME
    | TIMESTAMP (LPAREN INTEGER_LITERAL RPAREN)?
    | FUNCTION PATH
    | PACKAGE PATH
    | LOCK TIMEOUT
    | QUERY OPTIMIZATION
    | REFRESH AGE
    | EXPLAIN (MODE_ | SNAPSHOT)
    | DEFAULT TRANSFORM GROUP
    | DECFLOAT ROUNDING MODE_
    | MDC ROLLOUT MODE_
    | OPTIMIZATION PROFILE
    | FEDERATED ASYNCHRONY
    | IMPLICIT XMLPARSE OPTION
    | MAINTAINED TABLE? TYPES (FOR OPTIMIZATION)?
    | TEMPORAL (SYSTEM_TIME | BUSINESS_TIME)
    | LOCALE identifier
    | identifier   // SCHEMA, SQLID, USER, SERVER, PATH, TIMEZONE, DEGREE, ISOLATION, MEMBER, CLIENT_*, ...
    ;

case_expression
    : CASE expression simple_when_clause+ (ELSE expression)? END
    | CASE searched_when_clause+ (ELSE expression)? END
    ;

simple_when_clause
    : WHEN expression THEN expression
    ;

searched_when_clause
    : WHEN expression THEN expression
    ;

cast_expression
    : CAST LPAREN expression AS data_type RPAREN
    ;

// Generic function call: built-in scalar, aggregate and OLAP functions and
// user-defined functions. Covers DISTINCT/ALL, COUNT(*), ORDER BY inside the
// call (ARRAY_AGG, XMLAGG), WITHIN GROUP (LISTAGG, PERCENTILE_CONT) and OVER.
function_call
    : function_name LPAREN function_arguments? RPAREN within_group_clause? over_clause?
    ;

// LEFT, RIGHT, INSERT and CONCAT are reserved words that are also function names.
function_name
    : qualified_name
    | LEFT
    | RIGHT
    | INSERT
    | CONCAT
    ;

function_arguments
    : STAR
    | (ALL | DISTINCT)? function_argument (COMMA function_argument)* order_by_clause?
    ;

// Special argument forms: named arguments (=>), TRIM(LEADING x FROM s),
// SUBSTRING(s FROM a FOR b USING OCTETS), EXTRACT(YEAR FROM d),
// XMLELEMENT(NAME "x"), XMLCAST(x AS type), XMLATTRIBUTES(a AS "b"),
// XMLQUERY('..' PASSING x AS "d"), JSON_OBJECT(KEY 'k' VALUE v),
// JSON_VALUE(doc, '$.a' RETURNING type).
function_argument
    : identifier ARROW expression
    | (LEADING | TRAILING | BOTH) expression? FROM expression
    | NAME identifier
    | KEY expression VALUE expression
    | expression function_argument_suffix?
    ;

function_argument_suffix
    : FROM expression (FOR expression)? (USING identifier)?
    | FOR expression (USING identifier)?
    | AS data_type
    | USING identifier
    | RETURNING data_type
    | PASSING (BY (REF | VALUE))? expression (AS identifier)?
    ;

within_group_clause
    : WITHIN GROUP LPAREN order_by_clause RPAREN
    ;

over_clause
    : OVER LPAREN window_specification RPAREN
    ;

window_specification
    : (PARTITION BY expression_list)? order_by_clause? window_frame?
    ;

window_frame
    : (ROWS | RANGE) (BETWEEN window_frame_bound AND window_frame_bound | window_frame_bound)
    ;

window_frame_bound
    : UNBOUNDED (PRECEDING | FOLLOWING)
    | CURRENT ROW
    | value_expression (PRECEDING | FOLLOWING)
    ;

expression_list
    : expression (COMMA expression)*
    ;

// ============================================================================
// Literals
// ============================================================================

literal
    : string_literal                         # character_string_literal
    | HEX_STRING                             # hex_string_literal
    | BINARY_STRING                          # binary_string_literal
    | GRAPHIC_STRING                         # graphic_string_literal
    | HEX_GRAPHIC_STRING                     # hex_graphic_string_literal
    | UNICODE_STRING                         # unicode_string_literal
    | numeric_literal                        # number_literal
    | TRUE                                   # true_literal
    | FALSE                                  # false_literal
    | NULL                                   # null_literal
    | DATE string_literal                    # date_literal
    | TIME string_literal                    # time_literal
    | TIMESTAMP string_literal               # timestamp_literal
    ;

string_literal
    : STRING
    ;

numeric_literal
    : INTEGER_LITERAL
    | DECIMAL_LITERAL
    | FLOAT_LITERAL
    ;

// ============================================================================
// Data types
// ============================================================================

data_type
    : base_data_type (ARRAY LBRACKET (INTEGER_LITERAL | data_type)? RBRACKET)?
    ;

base_data_type
    : (CHARACTER | CHAR) VARYING length_spec? string_unit_suffix?
    | (CHARACTER | CHAR) LARGE OBJECT length_spec?
    | NATIONAL (CHARACTER | CHAR) VARYING? length_spec?
    | NATIONAL (CHARACTER | CHAR) LARGE OBJECT length_spec?
    | BINARY LARGE OBJECT length_spec?
    | BINARY VARYING length_spec?
    | LONG (VARCHAR | VARGRAPHIC) string_unit_suffix?
    | DOUBLE PRECISION?
    | RESULT_SET_LOCATOR VARYING
    | ROW LPAREN field_definition (COMMA field_definition)* RPAREN
    | ANCHOR DATA? TYPE? TO qualified_name
    | ROW? ANCHOR ROW OF? qualified_name
    | qualified_name length_spec? string_unit_suffix?   // INTEGER, VARCHAR(10), DECIMAL(10,2), CLOB(1M), user types
    ;

// (10), (10, 2), (100 OCTETS), (1M), (2 G), and () in routine signatures
length_spec
    : LPAREN (INTEGER_LITERAL identifier? (COMMA INTEGER_LITERAL)? identifier?)? RPAREN
    ;

string_unit_suffix
    : FOR (BIT | SBCS | MIXED) DATA
    | CCSID (INTEGER_LITERAL | ASCII | UNICODE | EBCDIC)
    ;

// ============================================================================
// Names and identifiers
// ============================================================================

qualified_name
    : identifier (DOT identifier)*
    ;

column_name_list
    : LPAREN identifier (COMMA identifier)* RPAREN
    ;

identifier
    : IDENTIFIER
    | QUOTED_IDENTIFIER
    | non_reserved_keyword
    | alias_restricted_keyword
    ;

// An alias written without AS may not be one of the words that can legally
// follow an expression or a table reference.
alias_name
    : IDENTIFIER
    | QUOTED_IDENTIFIER
    | non_reserved_keyword
    ;

alias_restricted_keyword
    : YEAR | YEARS | MONTH | MONTHS | DAY | DAYS | HOUR | HOURS
    | MINUTE | MINUTES | SECOND | SECONDS | MICROSECOND | MICROSECONDS
    | START | CONNECT | DO | LIMIT | OFFSET | TABLESAMPLE | OPTIMIZE | SKIP_ | WAIT
    | INCLUDE | MINUS | UNTIL
    ;

// ----- generated: non_reserved_keyword -----
// Keywords that this grammar does not reserve and that therefore remain usable as
// identifiers (generated by tools/generate_keywords.py).
non_reserved_keyword
    : ACCESS | ACTION | ACTIVATE | ADAPTIVE | ADD | ADMIN
    | ADMINISTRATION | AFTER | AGE | ALIAS | ALLOCATE | ALLOW
    | ALTER | ALWAYS | ANCHOR | APPEND | ARRAY | ASC
