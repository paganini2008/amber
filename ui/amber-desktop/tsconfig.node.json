{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/i18n/core.ts",
    "src/renderer/src/i18n/catalog.ts",
    "src/renderer/src/i18n/en/**/*",
    "src/renderer/src/i18n/zh-CN/**/*",
    "src/renderer/src/i18n/es/**/*",
    "test/**/*",
    "scripts/**/*.ts"
  ]
}
