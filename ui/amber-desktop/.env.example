# Amber desktop app: development configuration.
#
# Copy this file to ui/amber-desktop/.env (git-ignored) and change what you need.
# - Read only when the app runs from source (npm run dev / preview); a packaged app never reads a .env.
# - Variables already set in your shell win over this file.
# - These are dev wiring and DEFAULTS only. What a user saves in Settings always wins.
# - Never put database connections, hosts, users, passwords or AI API keys here: they are entered in
#   Settings (Connections, AI) and stored encrypted by the OS keychain.
# Leave a value empty to use the default shown in the comment.

# ---- Engine (development) ---------------------------------------------------------------------
# The engine jar to run (npm run stage-engine also packages the folder it is in, with its lib/).
# Relative paths are relative to ui/amber-desktop.
# Default: ../../backend/amber-core/target/engine/engine.jar
AMBER_ENGINE_JAR=
# The java executable (JDK 25). Default: $JAVA_HOME/bin/java, else java on the PATH.
AMBER_JAVA=
# Restarts of a crashed engine allowed within the window before the app gives up (default 5 in 60 s).
AMBER_ENGINE_MAX_RESTARTS=
AMBER_ENGINE_RESTART_WINDOW_SEC=

# ---- Debugging (development) ------------------------------------------------------------------
# Opens the Chrome DevTools Protocol on this port for scripted UI checks (default: off).
# `npx electron-vite dev --remoteDebuggingPort <port>` does the same for one run.
AMBER_DEV_CDP_PORT=
# Main-process logging: off | error | info | debug (default info; engine stderr lines are info).
AMBER_LOG_LEVEL=

# ---- Defaults for new settings (user settings win) ----------------------------------------------
# Base URLs the AI settings start with. Default: http://localhost:11434 and https://api.openai.com/v1
AMBER_DEFAULT_OLLAMA_URL=
AMBER_DEFAULT_OPENAI_URL=
# Seconds to wait for an AI answer (default 120).
AMBER_DEFAULT_AI_TIMEOUT_SEC=

# ---- Updates and limits -------------------------------------------------------------------------
# GitHub owner/repo whose latest release the update check reads (default paganini2008/amber).
AMBER_UPDATE_REPO=
# Seconds the update check waits for GitHub (default 10).
AMBER_UPDATE_TIMEOUT_SEC=
# Largest script the app opens, in MB (default 64).
AMBER_MAX_FILE_MB=
# Longest wait for a connection test or an online metadata load, in seconds (default 60).
AMBER_DB_TIMEOUT_SEC=
